require 'etc'

# 指定したグループ名のいずれかに所属しているかを判定する
#
# @param target_groups [Array<String>] 判定対象のグループ名
# @return [Boolean]
def belong_to_groups?(target_groups)
  gids = Process.groups + [Process.gid]

  gids.any? do |gid|
    begin
      name = Etc.getgrgid(gid).name
      target_groups.include?(name)
    rescue ArgumentError
      false
    end
  end
end
---
form:
  partition:
    widget: select
    label: Partition
    options:
      - [ fx700,       [fx700,       system/fx700 FJSVstclanga],       set-label-nodes: Number of nodes (1 - 40), set-max-nodes: 40 ]
      - [ a100,        [a100,        system/a100 nvhpc],               set-label-nodes: Number of nodes (1 - 2),  set-max-nodes:  2 ]
      - [ mi100,       [mi100,       system/mi100 rocm],               set-label-nodes: Number of nodes (1),      set-max-nodes:  1 ]
      - [ r340,        [r340,        ""],                              set-label-nodes: Number of nodes (1 - 2),  set-max-nodes:  2 ]
      - [ genoa,       [genoa,       system/genoa mpi/openmpi-x86_64], set-label-nodes: Number of nodes (1 - 16), set-max-nodes: 16 ]
      - [ genoa-m,     [genoa-m,     system/genoa mpi/openmpi-x86_64], set-label-nodes: Number of nodes (1),      set-max-nodes:  1 ]
      <% if belong_to_groups?(['rccs-hpbdrt', 'rccs-dmp']) %>
      - [ ai-h100l,    [ai-h100l,    system/ai-h100l nvhpc],           set-label-nodes: Number of nodes (1 - 2),  set-max-nodes:  2 ]
      <% end %>
      - [ ai-h100l-pu, [ai-h100l-pu, system/ai-h100l nvhpc],           set-label-nodes: Number of nodes (1 - 2),  set-max-nodes:  2, set-label-time_1: Maximum run time hours (0),     set-max-time_1: 0, set-label-time_2: Maximum run time minutes (0 - 30), set-max-time_2: 30 ]
      - [ ai-h200-brc, [ai-h200-brc, system/ai-h200-brc nvhpc],        set-label-nodes: Number of nodes (1),      set-max-nodes:  1, set-label-time_1: Maximum run time hours (0 - 8), set-max-time_1: 8, enable-gpus ]
      - [ ai-l40s,     [ai-l40s,     system/ai-l40s nvhpc] ,           set-label-nodes: Number of nodes (1 - 7),  set-max-nodes:  7, enable-gpus ]
      - [ qc-a100,     [qc-a100,     system/qc-a100 nvhpc],            set-label-nodes: Number of nodes (1 - 2),  set-max-nodes:  2, enable-gpus ]
      - [ qc-h100,     [qc-h100,     system/qc-h100 nvhpc],            set-label-nodes: Number of nodes (1),      set-max-nodes:  1 ]
      - [ qc-gh200,    [qc-gh200,    system/qc-gh200 nvhpc],           set-label-nodes: Number of nodes (1 - 8),  set-max-nodes:  8 ]
      - [ qc-mi210,    [qc-mi210,    system/qc-mi210],                 set-label-nodes: Number of nodes (1 - 2),  set-max-nodes:  2 ]
      - [ qc-mi250,    [qc-mi250,    system/qc-mi250 rocm],            set-label-nodes: Number of nodes (1 - 4),  set-max-nodes:  4 ]
      - [ qc-pvc,      [qc-pvc,      system/qc-pvc],                   set-label-nodes: Number of nodes (1 - 2),  set-max-nodes:  2 ]
      - [ fs-mi300a,   [fs-mi300a,   system/fs-mi300a rocm],           set-label-nodes: Number of nodes (1),      set-max-nodes:  1 ]
      - [ fs-mi300x,   [fs-mi300x,   system/fs-mi300x rocm],           set-label-nodes: Number of nodes (1),      set-max-nodes:  1 ]

  nodes:
    widget: number
    label: Number of nodes
    value: 1
    min: 1

  time:
    widget:   number
    label:    [ Maximum run time hours (0 - 24), Maximum run minutes (0 - 59) ]
    size:     2
    value:    [  1,  0 ]
    min:      [  0,  0 ]
    max:      [ 24, 59 ]
    step:     [  1,  1 ]

  gpus:
    widget:   number
    label:    Number of GPUs (1 - 8)
    value:    1
    min:      1
    max:      8
    required: true

  path:
    label: File
    widget: path
    
  advanced_options:
    widget: checkbox
    options:
      - [Advanced options, a, show-email, show-mail_option, show-array, show-log ]
   
  array:
    widget: number
    label: [ Array Job (start index), Array Job (last index) ]
    size: 2
    min:  [0, 0]
    help: Each job executed from an array job is assigned a task ID, which can be referenced in the shell script via the environment variable SLURM_ARRAY_TASK_ID.

  log:
    widget: text
    size: 2
    label: [Standard log (e.g. stdout.%j), Error log (e.g. stderr.%j)]
    help: The symbol %j will be replaced with the job ID.
    
  mail_option:
    label: Mail option
    widget: checkbox
    direction: horizontal
    separator: ","
    indent: 1
    options:
      - [ "Beginning of job execution", 'BEGIN',   enable-email ]
      - [ "End of job execution",       'END',     enable-email ]
      - [ "Fail of job",                'FAIL',    enable-email ]
      - [ "When the job is requeued",   'REQUEUE', enable-email ]
      - [ "All",                        'ALL',     enable-email ]

  email:
    widget: email
    label:  Email
    indent: 2
    
script: |
  #!/usr/bin/env bash
  #SBATCH -p #{partition_1}
  #SBATCH -N #{nodes}
  #SBATCH -t #{time_1}:#{zeropadding(time_2,2)}:00
  #SBATCH --gpus=#{gpus}
  #SBATCH --array=#{array_1}-#{array_2}
  #SBATCH --output=#{log_1}
  #SBATCH --error=#{log_2}
  #SBATCH --mail-user=#{email}
  #SBATCH --mail-type=#{mail_option}
  module load #{partition_2}
  
  #{path}
check: |
  if @partition == "ai-h200-brc"
    oc_assert((@time_1 !=  8 || @time_2 <= 0), "The run time is within 8 hours.")
  else
    oc_assert((@time_1 != 24 || @time_2 <= 0), "The run time is within 24 hours.")
  end
   
